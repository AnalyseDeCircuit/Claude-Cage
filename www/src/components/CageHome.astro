---
import '@fontsource-variable/inter';
import '../styles/cage.css';
import { cageCopy, languages, type CageLocale } from '../i18n/cage';
import published from '../data/release.json';
import art from '../../../assets/claude-cage-character.png';
import checks from '../../../assets/network-checks.png';
import communityCheck from '../../../assets/community-browser-check.png';
import qr from '../../../assets/community-qq.png';
interface Props { locale: CageLocale }
const { locale } = Astro.props;
const c = cageCopy[locale];
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/Lee-xeo/Claude-Cage';
const pathFor = (code: CageLocale) => `${base}${code === 'zh' ? '' : `${code}/`}`;
const canonical = new URL(pathFor(locale), Astro.site);
---
<!doctype html>
<html lang={c.lang} dir={c.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={c.description} />
  <meta name="theme-color" content="#faf8f4" />
  <title>{c.title}</title>
  <link rel="canonical" href={canonical} />
  {languages.map(l => <link rel="alternate" hreflang={l.lang} href={new URL(pathFor(l.code), Astro.site)} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
  <link rel="icon" href={`${base}cage-icon.png`} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Claude Cage" />
  <meta property="og:title" content={c.title} /><meta property="og:description" content={c.description} />
  <meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(art.src, Astro.site)} />
</head>
<body>
  <header class="nav wrap">
    <a class="brand" href={pathFor(locale)} aria-label={c.home}><img src={`${base}cage-icon.png`} width="40" height="40" alt="" /><span>Claude Cage</span></a>
    <nav><a href="#how">{c.start}</a><a href={repo}>GitHub ↗</a><a class="nav-download" href="#download">{c.downloadLabel} ↓</a></nav>
  </header>
  <div class="language-switch wrap"><label for="site-language">{c.languageLabel}</label><select id="site-language" aria-label={c.languageLabel}>{languages.map(l => <option value={pathFor(l.code)} selected={l.code === locale} lang={l.lang}>{l.name}</option>)}</select></div>
  <main id="main">
    <section class="story-hero wrap">
      <div class="story-copy"><span class="eyebrow"><span class="seed"></span>CLAUDE CAGE · v{published.version}</span><h1>{c.hero}{c.heroAccent && <><br /><em>{c.heroAccent}</em></>}</h1><p class="tagline">{c.tagline}</p><p class="hero-intro">{c.intro}</p><a class="button" href="#download">{c.downloadLabel} ↓</a><span class="requirements" dir="ltr">{c.requirements} · v{published.version}</span></div>
      <figure class="character"><img src={art.src} width={art.width} height={art.height} alt={c.artAlt} fetchpriority="high" /></figure>
    </section>
    <section class="manifesto wrap"><h2>{c.why}</h2><p>{c.whyText}</p><ul class="key-features">{c.keyFeatures.map(text => <li>{text}</li>)}</ul><p class="small-note">{c.whyNote}</p></section>
    <section class="tools wrap" aria-labelledby="tools-title"><div class="section-intro"><h2 id="tools-title">{c.featureTitle}</h2></div><div class="tool-list">{c.features.map(([title,text],i) => <article><span class="tool-icon" aria-hidden="true">{['>_','↔','◎','↗'][i]}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>
    <div class="wrap"><figure class="product"><div class="window-bar" dir="ltr"><span class="window-dots" aria-hidden="true">● ● ●</span><span>Claude Cage · v{published.version}</span><span class="window-label">macOS</span></div><img src={`${base}workbench.jpg`} width="1230" height="692" alt={c.workbench} loading="lazy" /><figcaption>{c.workbench}</figcaption></figure></div>
    <section class="evidence wrap"><h2>{c.evidenceTitle}</h2><div class="evidence-grid"><figure><a href={checks.src}><img src={checks.src} width={checks.width} height={checks.height} alt={c.checksLabel} loading="lazy" /></a><figcaption>{c.checksLabel}</figcaption></figure><figure><a href={communityCheck.src}><img src={communityCheck.src} width={communityCheck.width} height={communityCheck.height} alt={c.communityCheckLabel} loading="lazy" /></a><figcaption>{c.communityCheckLabel}</figcaption></figure></div><p class="small-note">{c.evidenceNote}</p></section>
    <section id="how" class="start-section"><div class="wrap"><div class="quick-start"><h2>{c.quickTitle}</h2><p>{c.quickText}</p><pre><code>{c.prompt}</code></pre><p class="small-note">{c.quickNote}</p></div><div class="section-heading"><h2 class="steps-title">{c.stepsTitle}</h2></div><div class="steps">{c.steps.map(([title,text],i)=><article><span class="step-number" dir="ltr">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div><details class="first-look"><summary>{c.firstLookLabel}<span aria-hidden="true">＋</span></summary><img src={`${base}first-run.jpg`} width="1230" height="692" alt={c.firstLookLabel} loading="lazy" /></details></div></section>
    <section id="boundaries" class="boundaries wrap"><h2>{c.boundaryTitle}</h2><div class="boundary-list">{c.boundaries.map(([title,text])=><article><span aria-hidden="true">↔</span><div>{title && <h3>{title}</h3>}<p>{text}</p></div></article>)}</div></section>
    <section id="download" class="download-section wrap"><div class="download-box"><img src={`${base}cage-icon.png`} width="84" height="84" alt="" /><span class="eyebrow">CLAUDE CAGE · ALPHA</span><h2>{c.downloadTitle}</h2><p>{c.downloadText}</p><a class="button" href={published.downloadURL}>{c.downloadLabel} ↗</a><div class="download-meta" dir="ltr"><span>v{published.version}</span><span>Apple Silicon</span><span>macOS 14+</span></div><p class="access-note">{c.downloadNote}</p><p class="access-note update-note">{c.updateNote}</p><a class="text-link" href={published.releaseURL}>{c.releaseNotesLabel} ↗</a></div></section>
    <section class="community-docs wrap" aria-labelledby="docs-title"><h2 id="docs-title">{c.docsTitle}</h2><div class="docs-body"><div class="docs-content"><p class="community-intro">{c.communityText}</p><div class="community-links"><a class="text-link" href={`${repo}/issues`}>{c.issuesLabel} ↗</a><a class="text-link" href={repo}>GitHub ↗</a></div><ul class="doc-links">{c.docs.map(doc => <li><a class="text-link" href={doc.href}>{doc.label} ↗</a><p>{doc.title}</p></li>)}</ul></div><figure class="community-qr"><a href={qr.src}><img src={qr.src} width={qr.width} height={qr.height} alt={c.group} loading="lazy" /></a><figcaption dir="ltr">{c.group}</figcaption></figure></div></section>

    <section class="license wrap"><h2>{c.licenseTitle}</h2><p>{c.licenseText}</p></section>
  </main>
  <footer class="wrap"><a class="brand" href={pathFor(locale)}><img src={`${base}cage-icon.png`} width="28" height="28" alt="" />Claude Cage</a><div><a href={repo}>GitHub ↗</a><a href={`${repo}/blob/main/${c.readmePath}`}>README ↗</a></div><small>{c.independent}</small></footer>
  <script>
    const language = document.querySelector<HTMLSelectElement>('#site-language');
    language?.addEventListener('change', () => { window.location.assign(language.value); });
  </script>
</body>
</html>
